	"description": "A Minecraft Mod that makes Modern Minecraft look like c0.30",
	"authors": [
		"SprainedSpark89"
	],
	"contact": {
		"sources": "https://github.com/SprainedSpark89/c0.30-ify"
	},
	"license": "CC0-1.0",
	"icon": "assets/c030-ify/icon.png",
	"environment": "*",
